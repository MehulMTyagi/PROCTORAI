{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProctorAI Candidate",
  "version": "0.1.0",
  "identifier": "com.proctorai.candidate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProctorAI Candidate",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self' asset: tauri: tauri://localhost",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8010 http://localhost:8010 http://127.0.0.1:8765 http://localhost:8765 https: wss:"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ws://127.0.0.1:5174 http://127.0.0.1:8010 http://127.0.0.1:8765"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
